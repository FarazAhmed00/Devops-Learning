
# Directory and Files Related Commands

pwd     =>	# show current path directory
ls      =>	# show files/folders in directory
ls -l   =>      # show detail list
ls -a   =>      # show hidden files
cd foldername	=> change directory
cd ..		=> one location up OR one step back from current space/directory
cd ~		=> home directory


# File Handling
touch file.txt           => new file created
cat file.txt             => show file content
nano/vim file.txt        => for file edit
cp file.txt newFile.txt  => copy file 
mv file.txt newFile.txt  => rename/move file
rm file.txt              => delete file
rm -r foldername         => delete folder
rm *.log                 => delete all files with .log (Delete files using WildCards)

# Directory Commands
mkdir myfolder        => create new folder 
rmdir myfolder        => delete empty folder
rm -rf myfolder       => forcefully delete folder/files
rm -rf myfolder/*     => Deleting only Content (Keeping Folder)
rm -r myfolder        => delete folder recursively ( with files )
ls -R directory_name  => to exectly what files and folder with be affectef before running rm command

# Searh & Info 
whoami  => Show current User
man ls  => Show manual of any command 
history => show all commands used before

# System Commands
clear    => Clear Screen or terminal 
date     => Show Current date/time 
top      => Show system Processes

